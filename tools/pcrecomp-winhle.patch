+
+/* Accelerator tables (RT_ACCELERATOR, type 9): entries are 8 bytes, fVirt at
+ * byte 0, key and cmd as WORDs at bytes 2 and 4.  TranslateAccelerator turns
+ * a matching WM_KEYDOWN into the menu command it stands for.  The game's
+ * menus are real Win32 menus and never drawn, so this is its only keyboard
+ * route to Start Game (F2) and the other menu commands. */
+#define MAX_ACCEL 16
+static struct { int used; uint32_t data, size; } g_accel[MAX_ACCEL];
+#define ACCEL_BASE 0x0AC00000u
+static void u_LoadAcceleratorsA(void) {                  /* (hinst, name) */
+    uint32_t hr = hle_find_resource(A32(0), A32(1), 9);
+    if (!hr) RET(0, 2);
+    uint32_t size = 0, data = hle_resource_data(A32(0), hr, &size);
+    if (!data || size < 8) RET(0, 2);
+    for (int i = 0; i < MAX_ACCEL; i++)
+        if (!g_accel[i].used) {
+            g_accel[i].used = 1, g_accel[i].data = data, g_accel[i].size = size;
+            RET(ACCEL_BASE + (uint32_t)i, 2);
+        }
+    RET(0, 2);
+}
+static void u_TranslateAcceleratorA(void) {              /* (hwnd, hAccel, &msg) */
+    uint32_t i = A32(1) - ACCEL_BASE, lp = A32(2);
+    uint32_t m = lp ? MEM32(lp + 4) : 0, vk = lp ? MEM32(lp + 8) : 0;
+    if (i >= MAX_ACCEL || !g_accel[i].used || !lp || (m != WM_KEYDOWN && m != WM_SYSKEYDOWN)) RET(0, 3);
+    const uint8_t *p = (const uint8_t *)hle_ptr(g_accel[i].data);
+    int shift = (g_keys[VK_SHIFT] & 0x80) != 0, ctrl = (g_keys[VK_CONTROL] & 0x80) != 0,
+        alt = (g_keys[VK_MENU] & 0x80) != 0;
+    for (uint32_t o = 0; o + 8 <= g_accel[i].size; o += 8) {
+        int fVirt = p[o], key = p[o + 2] | p[o + 3] << 8, cmd = p[o + 4] | p[o + 5] << 8;
+        if (!(fVirt & 1) || key != (int)(vk & 0xFF)) continue;   /* FVIRTKEY */
+        if (((fVirt & 4) != 0) != shift || ((fVirt & 8) != 0) != ctrl || ((fVirt & 16) != 0) != alt) continue;
+        hle_send(A32(0), (fVirt & 16) ? WM_SYSCOMMAND : WM_COMMAND, (uint32_t)cmd, 0);
+        RET(1, 3);
+    }
+    RET(0, 3);
+}
